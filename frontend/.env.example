# Base URL of the Simplifix backend API.
#
# Leave unset to use sensible defaults:
#   - Android emulator: http://10.0.2.2:8000 (emulator's alias for the host machine's localhost)
#   - Everything else (web, iOS simulator): http://localhost:8000
#
# Set this explicitly when testing on a physical device on the same Wi-Fi network as your
# backend, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.23:8000
EXPO_PUBLIC_API_URL=
