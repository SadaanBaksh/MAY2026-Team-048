PROJECT_NAME=Simplifix API
API_V1_STR=/api/v1

# Postgres
POSTGRES_USER=simplifix
POSTGRES_PASSWORD=simplifix
POSTGRES_DB=simplifix
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://simplifix:simplifix@localhost:5432/simplifix

# Auth
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS - comma separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# AWS S3 (photo / voice note uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# AI provider (server-side only). Use either "gemini" or "aipipe".
AI_PROVIDER=gemini

# Direct Google Gemini
GEMINI_API_KEY=
# Not "-flash-lite" - Google restricted that variant from new users/projects; check
# GET https://generativelanguage.googleapis.com/v1beta/models with your key before changing this.
GEMINI_MODEL=gemini-3.5-flash

# AI Pipe Gemini-compatible proxy (https://aipipe.org/#documentation)
AIPIPE_TOKEN=
AIPIPE_MODEL=gemini-2.5-flash-lite

# Public request duplicate suggestions. Scores at or above this value are sent to employees.
PUBLIC_SIMILARITY_THRESHOLD=0.80
PUBLIC_SIMILARITY_CANDIDATE_LIMIT=20

# SMTP (Gmail) for OTP emails
SMTP_EMAIL=
SMTP_APP_PASSWORD=
