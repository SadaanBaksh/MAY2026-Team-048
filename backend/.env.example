# Simplifix backend configuration.
#
# Copy this file to .env (`cp .env.example .env`) and fill in what you need. Everything below
# works as-is for local development except the AI/S3/SendGrid sections, which are optional and
# only needed for those specific features — see docs/setup.md for the full walkthrough.

# ── App identity (optional — safe to leave as-is) ───────────────────────────
PROJECT_NAME=Simplifix API
# URL prefix for every API route (e.g. /api/v1/tickets). Only change this if you also update
# the frontend's API client and every doc/script that hardcodes /api/v1.
API_V1_STR=/api/v1

# ── Database ─────────────────────────────────────────────────────────────
# Docker Compose (`docker compose up --build`, the recommended local setup — see docs/setup.md)
# reads ONLY these three to configure both the Postgres container and the API's connection to
# it. DATABASE_URL below is ignored in that setup; only change these three if you want different
# local credentials.
POSTGRES_USER=simplifix
POSTGRES_PASSWORD=simplifix
POSTGRES_DB=simplifix

# Used only if you run the API WITHOUT Docker Compose — a native PostgreSQL install (docs/setup.md
# Option B), running `uvicorn` directly, or a one-off script from your own shell. Under Docker
# Compose this is overridden automatically to point at the `db` container instead of `localhost`.
DATABASE_URL=postgresql+psycopg2://simplifix:simplifix@localhost:5432/simplifix

# ── Auth ─────────────────────────────────────────────────────────────────
# Any string works for local dev. Generate a real one before deploying anywhere reachable
# outside your machine:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS (optional — only matters for the Expo *web* build) ────────────────
# Comma-separated origins allowed to call this API from a browser. Native app / physical device
# requests are never affected by CORS either way, so leave this alone unless you're testing
# `expo start --web` against this backend.
BACKEND_CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ── AWS S3 — photo / voice-note uploads (optional) ──────────────────────────
# Leave blank to run without media uploads: everything else works, only upload endpoints will
# fail until these are set. See docs/s3-setup.md for a from-scratch walkthrough.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# ── AI features (optional) ──────────────────────────────────────────────────
# Leave blank to run without AI: everything else works, only AI endpoints (complaint analysis,
# resident chat, notice drafting, dashboard summaries, public-report duplicate detection) return
# a 503 until configured. Pick ONE provider below and set AI_PROVIDER to match — never put either
# credential in the frontend's .env, these are server-side only.
AI_PROVIDER=gemini

# Option 1: direct Google Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Not "-flash-lite" - Google restricted that variant from new users/projects; check
# GET https://generativelanguage.googleapis.com/v1beta/models with your key before changing this.
GEMINI_MODEL=gemini-3.5-flash

# Option 2: AI Pipe's Gemini-compatible proxy (https://aipipe.org/#documentation) — set
# AI_PROVIDER=aipipe above and fill these in instead of the two Gemini vars.
AIPIPE_TOKEN=
AIPIPE_MODEL=gemini-2.5-flash-lite

# Public-report duplicate-detection tuning (optional — sane defaults, only change if you know
# why). Matches at or above the threshold are sent to facility employees as merge suggestions.
PUBLIC_SIMILARITY_THRESHOLD=0.80
PUBLIC_SIMILARITY_CANDIDATE_LIMIT=20

# ── SendGrid — OTP emails for registration / password reset (optional) ─────
# Leave blank to run without email: the API still reports success on /auth/send-otp, but no
# email actually sends (only a logged warning) — easy to miss until someone says the OTP never
# arrived. SENDGRID_FROM_EMAIL must be a verified sender: app.sendgrid.com -> Settings ->
# Sender Authentication -> Single Sender Verification (no domain/DNS setup needed).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
